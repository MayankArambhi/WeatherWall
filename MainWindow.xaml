<Window x:Class="WeatherWall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherWall"
        mc:Ignorable="d"
        Title="WeatherWall" Height="750" Width="1100"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="icon_.ico">
    
    <Window.Resources>
        <ResourceDictionary>
            <!-- ========================================
                 PREMIUM GLASS-METAL AESTHETIC
                 Emerald Green & Cyan-Blue Glazed Surfaces
                 ======================================== -->

            <!-- Ultra-dark charcoal base: polished black glass foundation -->
            <Color x:Key="WindowBackgroundColor">#050505</Color>
            <Color x:Key="CardBackgroundColor">#0A0A0A</Color>

            <!-- Premium text colors: high contrast, sharp readability -->
            <Color x:Key="PrimaryTextColor">#F8F8F8</Color>
            <Color x:Key="SecondaryTextColor">#9DB5A8</Color>
            <Color x:Key="TertiaryTextColor">#6A8580</Color>

            <!-- Premium emerald-cyan accent: sharp, luminous, clean -->
            <Color x:Key="AccentColor">#1FDD77</Color>
            <Color x:Key="AccentColorBright">#2FED88</Color>
            <Color x:Key="AccentColorDim">#17A850</Color>

            <!-- Blue-green metallic tints for glossy reflections -->
            <Color x:Key="GlassReflectionColorCyan">#0A4A5F</Color>
            <Color x:Key="GlassReflectionColorGreen">#0A5A3F</Color>
            <Color x:Key="GlassMetallicBlue">#1A5A7F</Color>

            <!-- Subtle borders: minimal visual weight, rely on surfaces -->
            <Color x:Key="BorderColor">#1A4A3F</Color>
            <Color x:Key="BorderColorBright">#4ADE80</Color>
            <Color x:Key="BorderColorDim">#0A2A1F</Color>

            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="AccentBrushBright" Color="{StaticResource AccentColorBright}"/>
            <SolidColorBrush x:Key="AccentBrushDim" Color="{StaticResource AccentColorDim}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
            <SolidColorBrush x:Key="BorderBrushBright" Color="{StaticResource BorderColorBright}"/>

            <!-- ========================================
                 PREMIUM GLASS-METAL GRADIENT SYSTEM
                 Polished reflections with blue-green luminosity
                 ======================================== -->

            <!-- Glossy black glass with cyan-green top reflection: polished metal look -->
            <LinearGradientBrush x:Key="SubtleGlassBrush" StartPoint="0,0" EndPoint="0,1">
                <!-- Top: cyan-blue-tinted highlight for metallic sheen -->
                <GradientStop Color="#151F22" Offset="0.0"/>
                <!-- Mid: dark glass transition -->
                <GradientStop Color="#0D1315" Offset="0.2"/>
                <!-- Body: deep dark glass -->
                <GradientStop Color="#080A0C" Offset="0.6"/>
                <!-- Bottom: ultra-dark with subtle green undertone -->
                <GradientStop Color="#050608" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- Premium metallic reflection: glossy polished surface shine -->
            <LinearGradientBrush x:Key="GlossyHighlightBrush" StartPoint="0,0" EndPoint="0,0.3">
                <!-- Bright metallic top: cyan-tinted gloss -->
                <GradientStop Color="#1F3A3F" Offset="0.0"/>
                <!-- Sharp transition to dark -->
                <GradientStop Color="#0A1315" Offset="0.08"/>
                <!-- Fade to transparent -->
                <GradientStop Color="#080A0C" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- Blue-green metallic borders: subtle but premium, active states are bright -->
            <Color x:Key="GlassBorderColor">#0A2A24</Color>
            <Color x:Key="GlassAccentBorderColor">#0A2A24</Color>
            <!-- Bright accent border ONLY for interactive/active states -->
            <Color x:Key="GlassActiveBorderColor">#1FDD77</Color>

            <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}"/>
            <SolidColorBrush x:Key="GlassAccentBorderBrush" Color="{StaticResource GlassAccentBorderColor}"/>
            <SolidColorBrush x:Key="GlassActiveBorderBrush" Color="{StaticResource GlassActiveBorderColor}"/>

            <!-- ========================================
                 PREMIUM GLASS ELEVATION WITH METALLIC DEPTH
                 Blue-green reflective surfaces
                 ======================================== -->

            <!-- Elevated card surface: darker with blue-green reflective top -->
            <LinearGradientBrush x:Key="GlassElevationBrush" StartPoint="0,0" EndPoint="0,1">
                <!-- Top: cyan-blue metallic reflection -->
                <GradientStop Color="#141A1F" Offset="0.0"/>
                <!-- Quick transition -->
                <GradientStop Color="#0C1015" Offset="0.15"/>
                <!-- Body: deep polished glass -->
                <GradientStop Color="#0A0D10" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- Active state elevation: brighter with enhanced green-blue gloss -->
            <LinearGradientBrush x:Key="GlassElevationActiveBrush" StartPoint="0,0" EndPoint="0,1">
                <!-- Top: brighter cyan-green reflection -->
                <GradientStop Color="#1A2A2F" Offset="0.0"/>
                <!-- Green undertone in middle -->
                <GradientStop Color="#111A1F" Offset="0.15"/>
                <!-- Deep glass bottom -->
                <GradientStop Color="#0D101315" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- ========================================
                 STATUS CHIPS: SHARP GLASS-METAL STYLE
                 Blue-green luminous accents
                 ======================================== -->

            <!-- Weather chip: emerald-green glossy indicator -->
            <SolidColorBrush x:Key="WeatherChipBackground" Color="#0A3A28"/>
            <SolidColorBrush x:Key="WeatherChipForeground" Color="#1FDD77"/>
            <!-- Time chip: cyan-blue glossy indicator -->
            <SolidColorBrush x:Key="TimeChipBackground" Color="#0A2A38"/>
            <SolidColorBrush x:Key="TimeChipForeground" Color="#7DD5FF"/>

            <!-- ========================================
                 TYPOGRAPHY SYSTEM: Premium Futuristic
                 Single consistent geometric sans-serif
                 ======================================== -->

            <!-- Primary font stack: Segoe UI Variable (modern, sharp, geometric) -->
            <!-- Fallback: Inter, Geist, IBM Plex Sans (all modern, sharp, geometric) -->
            <FontFamily x:Key="PrimaryFontFamily">Segoe UI Variable Text, Segoe UI, Geist, Inter, IBM Plex Sans</FontFamily>

            <!-- Typography System: Single Premium Geometric Sans-Serif -->
            
            <Style x:Key="TitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            </Style>

            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            </Style>

            <Style x:Key="MetadataText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            </Style>

            <!-- Refined ListBox Selection with SHARP borders -->
            <Style x:Key="SubtleListBoxItem" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="SelectionBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="0">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource GlassActiveBorderBrush}"/>
                                    <Setter TargetName="SelectionBorder" Property="Background" Value="#08FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SelectionBorder" Property="Background" Value="#06FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Card with layered glossy surface and metallic sheen -->
            <!-- Use ContentControl as target because Border does not support Control Template -->
            <Style x:Key="ModernCard" TargetType="ContentControl">
                <Setter Property="Background" Value="{DynamicResource SubtleGlassBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
                <Setter Property="Padding" Value="24"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid>
                                <!-- Base polished glass surface -->
                                <Border x:Name="BaseSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0"/>

                                <!-- Metallic sheen: thin top highlight for polished edge -->
                                <Rectangle Height="26" VerticalAlignment="Top" Fill="{StaticResource GlossyHighlightBrush}" Opacity="0.12" IsHitTestVisible="False"/>

                                <!-- Subtle central gloss (soft reflection) -->
                                <Rectangle Fill="White" Opacity="0.02" IsHitTestVisible="False"/>

                                <!-- Content hosted inside card -->
                                <ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Button: Sharp, Vibrant, Premium Glossy Feel -->
            <Style TargetType="Button">
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="#000000"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="0"/>
                    </Style>
                </Style.Resources>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <!-- Brighter green on hover with subtle glow -->
                        <Setter Property="Background" Value="{DynamicResource AccentBrushBright}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrushBright}"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#1FDD77" BlurRadius="6" Opacity="0.3" ShadowDepth="0"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <!-- Slight opacity change on press for depth -->
                        <Setter Property="Opacity" Value="0.85"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Secondary Button: Transparent with subtle border, bright on hover -->
            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                <!-- Subtle border by default -->
                <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#08FFFFFF"/>
                        <!-- Bright accent on hover for emphasis -->
                        <Setter Property="BorderBrush" Value="{DynamicResource GlassActiveBorderBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Segmented Radio: Sharp selection state with premium glass effect -->
            <Style x:Key="SegmentedRadioButton" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="#000000"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#08FFFFFF"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Danger Button: Sharp red outline with premium style -->
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#FF7777"/>
                <Setter Property="BorderBrush" Value="#553333"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#25FF5555"/>
                        <Setter Property="BorderBrush" Value="#FF5555"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Chips: Sharp, Vibrant Status Indicators -->
            <Style x:Key="BaseChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Weather Chip: Bright green accent -->
            <Style x:Key="WeatherChip" TargetType="Border" BasedOn="{StaticResource BaseChip}">
                <Setter Property="Background" Value="{DynamicResource WeatherChipBackground}"/>
                <Setter Property="BorderBrush" Value="#1A4A35"/>
                <Style.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetadataText}">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="{DynamicResource WeatherChipForeground}"/>
                    </Style>
                </Style.Resources>
            </Style>

            <!-- Time Chip: Cool gray tone -->
            <Style x:Key="TimeChip" TargetType="Border" BasedOn="{StaticResource BaseChip}">
                <Setter Property="Background" Value="{DynamicResource TimeChipBackground}"/>
                <Setter Property="BorderBrush" Value="#2A2A2A"/>
                <Style.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetadataText}">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="{DynamicResource TimeChipForeground}"/>
                    </Style>
                </Style.Resources>
            </Style>

            <!-- ScrollBar: Slim, Sharp Utility Style -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
                <Setter Property="Width" Value="6"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="Bg" SnapsToDevicePixels="true">
                                <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border Background="{DynamicResource BorderBrush}" CornerRadius="0" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SmoothListBox" TargetType="ListBox">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource SubtleListBoxItem}"/>
            </Style>

            <!-- ComboBox: Premium, Sharp Input Control -->
            <Style TargetType="ComboBox">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                <!-- Use subtle border by default -->
                <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Name="ToggleButton" 
                                              BorderBrush="{TemplateBinding BorderBrush}" 
                                              Background="{TemplateBinding Background}" 
                                              Foreground="{TemplateBinding Foreground}"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Grid.Column="2">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Name="Border" CornerRadius="0" BorderThickness="1" 
                                                    Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Name="Arrow" Grid.Column="1" Fill="{DynamicResource SecondaryTextBrush}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#10FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="12,0,30,0" VerticalAlignment="Center"/>
                                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" 
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <!-- Subtle border on dropdown to match subtle design -->
                                        <Border Name="DropDownBorder" Background="{DynamicResource CardBackgroundBrush}" 
                                                BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}" CornerRadius="0"/>
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBoxItem: Premium dropdown items -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border Name="Border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="0">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="#0B0B0B"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="#0B0B0B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="28,16">
            <Grid MaxWidth="1400" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="0" Background="Transparent" Margin="0,0,14,0">
                        <Image Source="logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WeatherWall" Style="{StaticResource TitleText}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Adaptive Desktop Environments" Style="{StaticResource MetadataText}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource WeatherChipBackground}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="WeatherIconText" Text="⏳" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WeatherStatusText" Text="Syncing..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WeatherChipForeground}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="32,24" SelectionChanged="TabControl_SelectionChanged" MaxWidth="1400" HorizontalAlignment="Stretch">
            <TabControl.Resources>
                <!-- Tab Item: Sharp Active State with Glossy Highlight -->
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Padding="24,12" Margin="0,0,12,12" CornerRadius="0" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}"/>
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GlassActiveBorderBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#08FFFFFF"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GlassActiveBorderBrush}"/>
                                        <Setter TargetName="Border" Property="Background" Value="#06FFFFFF"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="CheckBox">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Library">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ContentControl Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Wallpaper Source" Style="{StaticResource MetadataText}" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="FolderPathText" Text="No folder selected" Style="{StaticResource BodyText}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <Button Content="Change Folder" Click="SelectFolder_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,6" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <TextBlock Text="Location &amp; Precision" Style="{StaticResource MetadataText}" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LocationInput" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="Search" Click="UpdateLocation_Click" Padding="12,0" Height="34" FontSize="12"/>
                                </Grid>
                                
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Lat" Style="{StaticResource MetadataText}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="LatInput" Height="28" VerticalContentAlignment="Center" Padding="4,0" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Text="Long" Style="{StaticResource MetadataText}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="LonInput" Height="28" VerticalContentAlignment="Center" Padding="4,0" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Set" Click="SetCoordinates_Click" Padding="8,0" Height="28" FontSize="11" VerticalAlignment="Bottom"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <CheckBox x:Name="AutoLocationCheck" Content="Auto-detect (Windows/IP)" VerticalAlignment="Center" Margin="0,0,16,0" Click="AutoLocation_Click"/>
                                    <CheckBox x:Name="StartWithWindowsCheck" Content="Auto-Start" VerticalAlignment="Center" Click="StartWithWindows_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ContentControl>
                    <ContentControl Grid.Row="1" Style="{StaticResource ModernCard}" Padding="12">
                        <Grid>
                            <ListBox x:Name="FileListBox" 
                                     Style="{StaticResource SmoothListBox}"
                                     SelectionChanged="FileListBox_SelectionChanged"
                                     HorizontalContentAlignment="Stretch">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" CornerRadius="0" Margin="0" Padding="12" BorderThickness="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="160" Height="90" CornerRadius="0" ClipToBounds="True" BorderThickness="1" BorderBrush="#3A5A4E">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Local Image" Style="{StaticResource MetadataText}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Apply Now" Click="SetWallpaper_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Padding="16,8" FontSize="13"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="NoWallpapersState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="Your library is empty" Style="{StaticResource SectionHeader}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Select a folder to start managing your wallpapers" Style="{StaticResource MetadataText}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ContentControl>
                </Grid>
            </TabItem>

            <TabItem Header="Automation Rules">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,24,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,24">
                                <Border HorizontalAlignment="Center" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ManualModeRadio" Content="Manual Tagging" Style="{StaticResource SegmentedRadioButton}" IsChecked="True" Checked="TaggingMode_Changed"/>
                                        <RadioButton x:Name="AIModeRadio" Content="AI Auto Tagging" Style="{StaticResource SegmentedRadioButton}" Checked="TaggingMode_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- MANUAL TAGGING PANEL -->
                            <Grid x:Name="ManualTaggingPanel" Grid.Row="1" Grid.RowSpan="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                    <TextBlock Text="1. Select Condition" Style="{StaticResource MetadataText}" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Weather" Style="{StaticResource MetadataText}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="RuleWeatherCombo" Height="38">
                                                <ComboBoxItem Content="clear" IsSelected="True"/>
                                                <ComboBoxItem Content="partly_cloudy"/>
                                                <ComboBoxItem Content="cloudy"/>
                                                <ComboBoxItem Content="overcast"/>
                                                <ComboBoxItem Content="rainy"/>
                                                <ComboBoxItem Content="drizzle"/>
                                                <ComboBoxItem Content="thunderstorm"/>
                                                <ComboBoxItem Content="foggy"/>
                                                <ComboBoxItem Content="snowy"/>
                                                <ComboBoxItem Content="windy"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Time of Day" Style="{StaticResource MetadataText}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="RuleTimeCombo" Height="38">
                                                <ComboBoxItem Content="morning" IsSelected="True"/>
                                                <ComboBoxItem Content="afternoon"/>
                                                <ComboBoxItem Content="evening"/>
                                                <ComboBoxItem Content="night"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="2. Choose Wallpaper" Style="{StaticResource MetadataText}" FontWeight="Bold" Margin="0,0,0,12"/>
                                <Border Grid.Row="2" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="0" Margin="0,0,0,16">
                                    <ListBox x:Name="RuleWallpaperGallery" 
                                             Style="{StaticResource SmoothListBox}"
                                             Padding="8">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="144" Height="81" CornerRadius="0" Margin="6" ClipToBounds="True" BorderThickness="1" BorderBrush="#3A5A4E">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel IsItemsHost="True" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </Border>
                                <Button Grid.Row="3" Content="Add Rule" Click="CreateRule_Click" Height="48" FontWeight="Bold"/>
                            </Grid>

                            <!-- AI AUTO TAGGING PANEL -->
                            <Grid x:Name="AITaggingPanel" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Experimental / Mock Analysis" Style="{StaticResource MetadataText}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource AccentBrush}" Margin="8,0,0,0" Padding="6,2" CornerRadius="0" VerticalAlignment="Center">
                                            <TextBlock Text="BETA" FontSize="10" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Automatically scan your library to find the best wallpaper for each condition based on basic visual cues. This happens entirely locally." Style="{StaticResource BodyText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Text="AI tagging is currently experimental and may not always assign perfectly accurate conditions. Results may require manual review." Style="{StaticResource MetadataText}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,16" FontStyle="Italic" Opacity="0.8"/>
                                    
                                    <Button x:Name="GenerateTagsBtn" Content="Analyze Library" Click="GenerateTags_Click" Height="48" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <Border Grid.Row="1" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="0" Background="{DynamicResource WindowBackgroundBrush}" Margin="0,0,0,16">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="AITagResultsPanel" Margin="16">
                                            <TextBlock Text="Ready to analyze." Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                                <Button Grid.Row="2" x:Name="CreateSuggestedRulesBtn" Content="Accept Suggestions" Click="CreateSuggestedRules_Click" Height="48" FontWeight="Bold" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                            </Grid>
                        </Grid>
                    </ContentControl>

                    <ContentControl Grid.Column="1" Style="{StaticResource ModernCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,24">
                                <TextBlock Text="Active Rules" Style="{StaticResource SectionHeader}"/>
                                <Button Content="Refresh Rules" Click="TestRules_Click" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="16,6" FontSize="12"/>
                            </Grid>
                            <ListBox Grid.Row="1" x:Name="ActiveRulesListBox" 
                                     Style="{StaticResource SmoothListBox}"
                                     HorizontalContentAlignment="Stretch">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource GlassElevationActiveBrush}" CornerRadius="0" Margin="0,0,0,8" Padding="16" Height="110" BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}" Opacity="{Binding Opacity}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="144"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="144" Height="81" CornerRadius="0" ClipToBounds="True" BorderThickness="1" BorderBrush="#3A5A4E">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <Border Background="#99000000" Visibility="{Binding MissingVisibility}">
                                                            <TextBlock Text="MISSING" Foreground="#FF6666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource BodyText}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                        <Border Style="{StaticResource WeatherChip}" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Weather}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource TimeChip}">
                                                            <TextBlock Text="{Binding TimePeriod}"/>
                                                        </Border>
                                                    </StackPanel>

                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Preview" Click="PreviewRule_Click" Padding="16,10" Margin="0,0,12,0" FontSize="13">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Delete" Click="DeleteRule_Click" Style="{StaticResource DangerButton}" Padding="16,10" FontSize="13"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="NoRulesState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="⚡" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="No active rules" Style="{StaticResource SectionHeader}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Create a rule on the left to automate your workspace" Style="{StaticResource MetadataText}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ContentControl>
                </Grid>
            </TabItem>

            <TabItem Header="Weather Settings">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <!-- WEATHER ACCURACY STATUS CARD -->
                        <ContentControl Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Weather Accuracy Status" Style="{StaticResource SectionHeader}"/>
                                
                                <TextBlock Text="Detected Location" Style="{StaticResource MetadataText}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="ConsensusLocationText" Text="Syncing Location..." Style="{StaticResource TitleText}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" TextTrimming="CharacterEllipsis"/>
                                
                                <Grid Margin="0,4,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Current Weather" Style="{StaticResource MetadataText}"/>
                                        <TextBlock x:Name="ConsensusConditionText" Text="Clear" Style="{StaticResource BodyText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Consensus Confidence" Style="{StaticResource MetadataText}" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="ConsensusConfidenceText" Text="100%" Style="{StaticResource BodyText}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Last Sync" Style="{StaticResource MetadataText}"/>
                                        <TextBlock x:Name="LastSuccessfulSyncText" Text="Never" Style="{StaticResource BodyText}" FontSize="12" FontFamily="{StaticResource PrimaryFontFamily}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Cache Status" Style="{StaticResource MetadataText}"/>
                                        <TextBlock x:Name="CacheStatusText" Text="Stale" Style="{StaticResource BodyText}" FontSize="12" FontFamily="{StaticResource PrimaryFontFamily}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="RefreshWeatherBtn" Content="Refresh Weather" Click="RefreshWeather_Click" HorizontalAlignment="Stretch" Padding="20,10" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </ContentControl>

                        <!-- MANUAL OVERRIDE CARD -->
                        <ContentControl Style="{StaticResource ModernCard}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Manual Weather Override" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Current weather looks wrong?" Style="{StaticResource MetadataText}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Override automatic weather if it is inaccurate. This override will expire in 4 hours." Style="{StaticResource MetadataText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                
                                <CheckBox x:Name="ManualOverrideCheckBox" Content="Enable Manual Override" Checked="ManualOverride_Checked" Unchecked="ManualOverride_Unchecked" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                
                                <TextBlock Text="Select Weather" Style="{StaticResource MetadataText}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="OverrideWeatherCombo" Height="36" SelectionChanged="OverrideWeatherCombo_SelectionChanged" Margin="0,0,0,8">
                                    <ComboBoxItem Content="Clear" IsSelected="True"/>
                                    <ComboBoxItem Content="Partly Cloudy"/>
                                    <ComboBoxItem Content="Cloudy"/>
                                    <ComboBoxItem Content="Overcast"/>
                                    <ComboBoxItem Content="Rainy"/>
                                    <ComboBoxItem Content="Thunderstorm"/>
                                    <ComboBoxItem Content="Foggy"/>
                                    <ComboBoxItem Content="Snowy"/>
                                </ComboBox>
                                
                                <TextBlock x:Name="OverrideExpiresText" Text="" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="{StaticResource PrimaryFontFamily}"/>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                    
                    <!-- RIGHT COLUMN: Advanced Settings and System Diagnostics (Collapsible expanders) -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">
                            
                            <!-- ADVANCED INFO BOX -->
                            <ContentControl Style="{StaticResource ModernCard}" Padding="20,16" Margin="0,0,0,24" BorderBrush="#3ADE80" Background="#0D4ADE80">
                                <StackPanel>
                                    <TextBlock Text="WEATHER ENGINE STATUS" Style="{StaticResource SectionHeader}" Foreground="{DynamicResource AccentBrushBright}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Open-Meteo and MET Norway are active by default. Optional alternative provider APIs can be configured inside the advanced settings below." 
                                               Style="{StaticResource MetadataText}" TextWrapping="Wrap" LineHeight="16" Foreground="{DynamicResource PrimaryTextBrush}" Opacity="0.9"/>
                                </StackPanel>
                            </ContentControl>

                            <!-- COLLAPSIBLE API KEYS EXPANDER -->
                            <ContentControl Style="{StaticResource ModernCard}" Margin="0,0,0,24" Padding="0" BorderThickness="1">
                                <Expander x:Name="ApiKeysExpander" IsExpanded="False" Background="Transparent" BorderThickness="0" Padding="20">
                                    <Expander.Header>
                                        <TextBlock Text="ADVANCED PROVIDER SETTINGS (OPTIONAL)" Style="{StaticResource SectionHeader}" Margin="4,8,0,8"/>
                                    </Expander.Header>
                                    
                                    <StackPanel Margin="0,16,0,0">
                                        <TextBlock Text="Provide API keys for additional weather stations to enable multi-source consensus comparison." Style="{StaticResource MetadataText}" Margin="0,0,0,20"/>
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <StackPanel Margin="0,0,12,16">
                                                <TextBlock Text="OpenWeatherMap API Key" Style="{StaticResource MetadataText}" Margin="0,0,0,6"/>
                                                <PasswordBox x:Name="OpenWeatherMapKeyInput" Height="36" VerticalContentAlignment="Center" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" Margin="0,0,0,16">
                                                <TextBlock Text="WeatherAPI Key" Style="{StaticResource MetadataText}" Margin="0,0,0,6"/>
                                                <PasswordBox x:Name="WeatherApiKeyInput" Height="36" VerticalContentAlignment="Center" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Row="1" Margin="0,0,12,0">
                                                <TextBlock Text="Tomorrow.io API Key" Style="{StaticResource MetadataText}" Margin="0,0,0,6"/>
                                                <PasswordBox x:Name="TomorrowIoKeyInput" Height="36" VerticalContentAlignment="Center" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <TextBlock Text="AccuWeather API Key" Style="{StaticResource MetadataText}" Margin="0,0,0,6"/>
                                                <PasswordBox x:Name="AccuWeatherKeyInput" Height="36" VerticalContentAlignment="Center" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <Button Content="Save API Keys" Click="SaveApiKeys_Click" HorizontalAlignment="Right" Margin="0,20,0,0" Padding="20,10" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Expander>
                            </ContentControl>

                            <!-- COLLAPSIBLE SYSTEM LOGS EXPANDER -->
                            <ContentControl Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="0" BorderThickness="1">
                                <Expander x:Name="DiagnosticsExpander" IsExpanded="False" Background="Transparent" BorderThickness="0" Padding="20">
                                    <Expander.Header>
                                        <TextBlock Text="DEVELOPER DIAGNOSTICS &amp; LOGS" Style="{StaticResource SectionHeader}" Margin="4,8,0,8"/>
                                    </Expander.Header>
                                    
                                    <Grid Margin="0,16,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Text="Consensus Diagnostics Logs" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                        
                                        <TextBox Grid.Row="1" x:Name="DiagnosticsLogsText" Height="220"
                                                 Background="{DynamicResource WindowBackgroundBrush}" 
                                                 BorderBrush="{DynamicResource BorderBrush}" 
                                                 Foreground="{DynamicResource SecondaryTextBrush}" 
                                                 IsReadOnly="True" 
                                                 TextWrapping="Wrap" 
                                                 AcceptsReturn="True" 
                                                 VerticalScrollBarVisibility="Auto" 
                                                 FontFamily="{StaticResource PrimaryFontFamily}" 
                                                 FontSize="11" 
                                                 Padding="12"
                                                 Margin="0,0,0,16"/>
                                                 
                                        <Button Grid.Row="2" Content="Copy Diagnostics to Clipboard" Click="CopyDiagnostics_Click" HorizontalAlignment="Right" Padding="16,8" FontSize="12" Style="{StaticResource SecondaryButton}"/>
                                    </Grid>
                                </Expander>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="About">
                <ContentControl Style="{StaticResource ModernCard}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                        <Border Width="100" Height="100" CornerRadius="0" Background="Transparent" Margin="0,0,0,24" HorizontalAlignment="Center">
                            <Image Source="logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="WeatherWall" Style="{StaticResource TitleText}" HorizontalAlignment="Center" FontSize="32"/>
                        <TextBlock Text="Version 1.2.0" Style="{StaticResource MetadataText}" HorizontalAlignment="Center" Margin="0,8,0,24"/>
                        <TextBlock Text="A premium Windows utility that automatically synchronizes your desktop wallpaper with real-time weather conditions. Designed for minimal intrusion and maximum workspace comfort." 
                                   TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyText}" Margin="0,0,0,32" Opacity="0.8"/>
                        
                        <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="0" Padding="20" BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}">
                            <StackPanel>
                                <TextBlock Text="System Status" Style="{StaticResource MetadataText}" FontWeight="Bold" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Engine" Style="{StaticResource MetadataText}"/>
                                        <TextBlock Text="IDesktopWallpaper COM" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Resources" Style="{StaticResource MetadataText}"/>
                                        <TextBlock Text="Optimized (Low RAM)" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ContentControl>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0" Padding="32,12">
            <Grid MaxWidth="1400" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusMatchedText" Text="Rule Match: None" Style="{StaticResource MetadataText}" FontFamily="{StaticResource PrimaryFontFamily}" Margin="0,0,24,0" VerticalAlignment="Center"/>
                    <TextBlock Text="|" Style="{StaticResource MetadataText}" Margin="0,0,24,0" VerticalAlignment="Center" Opacity="0.3"/>
                    <TextBlock x:Name="StatusLastUpdateText" Text="Last Sync: Never" Style="{StaticResource MetadataText}" FontFamily="{StaticResource PrimaryFontFamily}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusConditionText" Text="CLEAR · MORNING" Style="{StaticResource MetadataText}" FontFamily="{StaticResource PrimaryFontFamily}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="|" Style="{StaticResource MetadataText}" Margin="0,0,16,0" VerticalAlignment="Center" Opacity="0.3"/>
                    <TextBlock x:Name="AutoSyncLabel" Text="ENGINE STATUS: ACTIVE" Style="{StaticResource MetadataText}" FontFamily="{StaticResource PrimaryFontFamily}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource AccentBrush}" Opacity="0.08" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="14,4">
                    <TextBlock x:Name="StatusModeText" Text="RUNNING" FontSize="11" FontFamily="{StaticResource PrimaryFontFamily}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
