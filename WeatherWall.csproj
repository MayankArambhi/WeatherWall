    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>WW\Small_NoBG.ico</ApplicationIcon>
    <Title>WeatherWall</Title>
    <Company>WeatherWall</Company>
    <Product>WeatherWall</Product>
    <Description>Adaptive Desktop Environments</Description>
    <Version>1.0.0</Version>
    <Authors>WeatherWall Team</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="WW\HD.png" />
    <Resource Include="WW\Small_NoBG.ico" />
    <Resource Include="logo.png" />
  </ItemGroup>

</Project>
