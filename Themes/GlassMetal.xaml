<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Extended Glass-Metal theme: palette, brushes, and core control styles -->

    <!-- Typography: single geometric sans-serif for entire app -->
    <FontFamily x:Key="PrimaryFontFamily">Segoe UI Variable Text, Segoe UI, Inter, Geist, IBM Plex Sans</FontFamily>

    <!-- Palette (inspired by design image) -->
    <Color x:Key="WindowBackgroundColor">#0A0F14</Color>
    <Color x:Key="CardBackgroundColor">#07090B</Color>

    <Color x:Key="PrimaryTextColor">#EAFEF6</Color>
    <Color x:Key="SecondaryTextColor">#9DB5A8</Color>
    <Color x:Key="TertiaryTextColor">#6A8580</Color>

    <!-- Accent greens/cyans from the moodboard -->
    <Color x:Key="AccentColor">#00E6B3</Color>
    <Color x:Key="AccentColorBright">#00FF9D</Color>
    <Color x:Key="AccentColorDim">#00B27F</Color>

    <!-- Borders / metallic tints -->
    <Color x:Key="GlassBorderColor">#082D2A</Color>
    <Color x:Key="GlassActiveBorderColor">#00E6B3</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentBrushBright" Color="{StaticResource AccentColorBright}"/>
    <SolidColorBrush x:Key="AccentBrushDim" Color="{StaticResource AccentColorDim}"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}"/>
    <SolidColorBrush x:Key="GlassActiveBorderBrush" Color="{StaticResource GlassActiveBorderColor}"/>

    <!-- Glossy glass gradient and highlights -->
    <LinearGradientBrush x:Key="SubtleGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#081214" Offset="0.0"/>
        <GradientStop Color="#0A0F14" Offset="0.18"/>
        <GradientStop Color="#07090B" Offset="0.6"/>
        <GradientStop Color="#020405" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlossyHighlightBrush" StartPoint="0,0" EndPoint="0,0.28">
        <GradientStop Color="#0B3030" Offset="0.0"/>
        <GradientStop Color="#041214" Offset="0.08"/>
        <GradientStop Color="#00000000" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassElevationBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A1012" Offset="0.0"/>
        <GradientStop Color="#07090B" Offset="0.15"/>
        <GradientStop Color="#050607" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassElevationActiveBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0C2221" Offset="0.0"/>
        <GradientStop Color="#071314" Offset="0.15"/>
        <GradientStop Color="#050607" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Status chips -->
    <SolidColorBrush x:Key="WeatherChipBackground" Color="#063A28"/>
    <SolidColorBrush x:Key="WeatherChipForeground" Color="#00E6B3"/>
    <SolidColorBrush x:Key="TimeChipBackground" Color="#072536"/>
    <SolidColorBrush x:Key="TimeChipForeground" Color="#7DD5FF"/>

    <!-- ========================================
         PREMIUM MICRO-ANIMATIONS & EASING
         Fast, smooth, responsive (100-250ms)
         ======================================== -->
    
    <!-- Easing functions for premium feel -->
    <CubicEase x:Key="EaseInOutCubic" EasingMode="EaseInOut"/>
    <QuadraticEase x:Key="EaseInOutQuad" EasingMode="EaseInOut"/>
    <SineEase x:Key="EaseInOutSine" EasingMode="EaseInOut"/>
    
    <!-- Button Hover: Smooth brightness increase -->
    <Storyboard x:Key="ButtonHoverEnter">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.120">
            <EasingDoubleKeyFrame KeyTime="0:0:0.120" Value="1.0" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Button Click: Quick press effect (0.98x scale) -->
    <Storyboard x:Key="ButtonPressDown">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" Duration="0:0:0.080">
            <EasingDoubleKeyFrame KeyTime="0:0:0.080" Value="0.98" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" Duration="0:0:0.080">
            <EasingDoubleKeyFrame KeyTime="0:0:0.080" Value="0.98" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Button Release: Smooth return to normal -->
    <Storyboard x:Key="ButtonPressUp">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" Duration="0:0:0.150">
            <EasingDoubleKeyFrame KeyTime="0:0:0.150" Value="1.0" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" Duration="0:0:0.150">
            <EasingDoubleKeyFrame KeyTime="0:0:0.150" Value="1.0" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Card Hover: Smooth elevation and brightness -->
    <Storyboard x:Key="CardHoverEnter">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.120">
            <EasingDoubleKeyFrame KeyTime="0:0:0.120" Value="1.0" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Fade In: Smooth content appearance (150ms) -->
    <Storyboard x:Key="FadeIn">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.150">
            <EasingDoubleKeyFrame KeyTime="0:0:0.150" Value="1.0" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Fade Out: Smooth content disappearance (150ms) -->
    <Storyboard x:Key="FadeOut">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.150">
            <EasingDoubleKeyFrame KeyTime="0:0:0.150" Value="0.0" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Dropdown Open: Fade + slight expand (130ms) -->
    <Storyboard x:Key="DropdownOpen">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.130">
            <EasingDoubleKeyFrame KeyTime="0:0:0.130" Value="1.0" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Dropdown Close: Quick collapse (100ms) -->
    <Storyboard x:Key="DropdownClose">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.100">
            <EasingDoubleKeyFrame KeyTime="0:0:0.100" Value="0.0" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Window Launch: Smooth fade in (250ms) -->
    <Storyboard x:Key="WindowFadeIn">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.250">
            <EasingDoubleKeyFrame KeyTime="0:0:0.250" Value="1.0" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Thumbnail Fade In: Progressive appearance (200ms) -->
    <Storyboard x:Key="ThumbnailFadeIn">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.200">
            <EasingDoubleKeyFrame KeyTime="0:0:0.200" Value="1.0" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Weather Status Transition: Fade out old, fade in new (200ms total) -->
    <Storyboard x:Key="WeatherStatusFadeOut">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.150">
            <EasingDoubleKeyFrame KeyTime="0:0:0.150" Value="0.0" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="WeatherStatusFadeIn">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.150">
            <EasingDoubleKeyFrame KeyTime="0:0:0.000" Value="0.0"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.150" Value="1.0" EasingFunction="{StaticResource EaseInOutCubic}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Global font fallback styles -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <Style TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
    </Style>



    <!-- Primary Button: Sharp, Vibrant, Premium Glossy Feel with Animations -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="0.5" CenterY="0.5"/>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrushBright}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrushBright}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#00E6B3" BlurRadius="6" Opacity="0.28" ShadowDepth="0"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource ButtonPressDown}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource ButtonPressUp}"/>
                </Trigger.ExitActions>
                <Setter Property="Opacity" Value="0.85"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary Button with smooth transitions -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="0.5" CenterY="0.5"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#08FFFFFF"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GlassActiveBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource ButtonPressDown}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource ButtonPressUp}"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SegmentedRadioButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="0.5" CenterY="0.5"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="#08FFFFFF"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ModernCard with smooth hover elevation -->
    <Style x:Key="ModernCard" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource SubtleGlassBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="BaseSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Rectangle Height="26" VerticalAlignment="Top" Fill="{StaticResource GlossyHighlightBrush}" Opacity="0.12" IsHitTestVisible="False"/>
                        <Rectangle Fill="White" Opacity="0.02" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
