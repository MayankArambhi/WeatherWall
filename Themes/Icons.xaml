<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=mscorlib">

  <!-- Icon color palette (single-family, dynamic) -->
  <SolidColorBrush x:Key="IconBrush" Color="#E6E6E6"/><!-- default light gray -->
  <SolidColorBrush x:Key="IconActiveBrush" Color="#1D8B50"/><!-- emerald -->
  <SolidColorBrush x:Key="IconHoverBrush" Color="#2EDC9A"/><!-- subtle highlight -->
  <SolidColorBrush x:Key="IconErrorBrush" Color="#D66B6B"/><!-- muted red -->

  <!-- Common stroke width for all line icons -->
  <System:Double x:Key="IconStrokeWidth">1.6</System:Double>

  <!-- Simple geometry set for core icons. These are minimalist line shapes. -->
  <!-- Sun -->
  <Geometry x:Key="Icon.Sun">M12,6 A4,4 0 1 1 11.999,6 Z</Geometry>
  <!-- Cloud -->
  <Geometry x:Key="Icon.Cloud">M4,12 C2,12 1,10 1,8 C1,6 3,4 5,4 C6,4 7,4 8,5 C9,3 11,2 13,3 C15,3 16,5 16,7 C18,7 19,9 19,11 C19,13 17,14 15,14 L5,14 C4,14 4,13 4,12 Z</Geometry>
  <!-- Rain drop (single) -->
  <Geometry x:Key="Icon.Rain">M8,4 C8,4 6,7 6,9 A2,2 0 1 0 10,9 C10,7 8,4 8,4 Z</Geometry>
  <!-- Lightning -->
  <Geometry x:Key="Icon.Lightning">M10,2 L6,10 L11,10 L7,18 L14,8 L10,8 Z</Geometry>
  <!-- Snowflake (simple star) -->
  <Geometry x:Key="Icon.Snow">M10,2 L10,18 M2,10 L18,10 M4,4 L16,16 M16,4 L4,16</Geometry>
  <!-- Fog/mist -->
  <Geometry x:Key="Icon.Fog">M3,8 L17,8 M2,12 L18,12 M4,16 L16,16</Geometry>
  <!-- Wind -->
  <Geometry x:Key="Icon.Wind">M3,8 C6,6 10,6 13,8 C16,10 18,12 20,12</Geometry>
  <!-- Moon -->
  <Geometry x:Key="Icon.Moon">M12,2 A8,8 0 1 0 20,10 A6,6 0 1 1 12,2 Z</Geometry>
  <!-- Sunrise (horizon with rising sun) -->
  <Geometry x:Key="Icon.Sunrise">M2,14 L22,14 M12,6 A4,4 0 1 1 11.999,6 Z M2,14 L6,10 M18,10 L22,14</Geometry>
  <!-- Sunset (sun at horizon) -->
  <Geometry x:Key="Icon.Sunset">M2,14 L22,14 M12,10 A2,2 0 1 1 11.999,10 Z</Geometry>

  <!-- UI utility icons -->
  <Geometry x:Key="Icon.Plus">M12,5 L12,19 M5,12 L19,12</Geometry>
  <Geometry x:Key="Icon.Refresh">M4,6 A8,8 0 1 1 5,3 L5,8</Geometry>
  <Geometry x:Key="Icon.Eye">M2,12 C6,6 18,6 22,12 C18,18 6,18 2,12 Z M12,9 A3,3 0 1 1 11.999,9 Z</Geometry>
  <Geometry x:Key="Icon.Trash">M6,6 L18,6 M8,6 L8,4 C8,3 9,2 10,2 L14,2 C15,2 16,3 16,4 L16,6 M9,9 L9,18 M15,9 L15,18</Geometry>
  <Geometry x:Key="Icon.Folder">M3,7 L9,7 L11,9 L21,9 L21,19 L3,19 Z</Geometry>
  <Geometry x:Key="Icon.Image">M3,19 L21,19 L21,5 L3,5 Z M6,12 L9,8 L14,15 L18,11</Geometry>
  <Geometry x:Key="Icon.Pin">M12,2 L14,6 L18,8 L14,10 L12,18 L10,10 L6,8 L10,6 Z</Geometry>
  <Geometry x:Key="Icon.GPS">M12,2 C16,6 18,10 12,20 C6,10 8,6 12,2 Z M12,10 A2,2 0 1 1 11.999,10 Z</Geometry>
  <Geometry x:Key="Icon.Globe">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M2,12 H22 M12,2 V22</Geometry>
  <Geometry x:Key="Icon.Search">M21,21 L16,16 M11,18 A7,7 0 1 1 11,4 A7,7 0 1 1 11,18 Z</Geometry>
  <Geometry x:Key="Icon.Sparkle">M12,3 L13,7 L17,8 L13,9 L12,13 L11,9 L7,8 L11,7 Z</Geometry>
  <Geometry x:Key="Icon.Gauge">M3,12 A9,9 0 1 1 21,12 M12,12 L16,8</Geometry>
  <Geometry x:Key="Icon.Warning">M12,4 L2,20 L22,20 Z M12,9 L12,14 M12,17 L12,17</Geometry>

  <!-- Generic icon style for Path usage -->
  <Style x:Key="Icon.PathStyle" TargetType="Path">
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="{DynamicResource IconBrush}"/>
    <Setter Property="StrokeThickness" Value="1.6"/>
    <Setter Property="StrokeStartLineCap" Value="Square"/>
    <Setter Property="StrokeEndLineCap" Value="Square"/>
    <Setter Property="StrokeLineJoin" Value="Miter"/>
    <Setter Property="Fill" Value="Transparent"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- Interactive Path style: changes stroke based on parent control state -->
  <Style x:Key="Icon.InteractivePathStyle" TargetType="Path" BasedOn="{StaticResource Icon.PathStyle}">
    <Style.Triggers>
      <!-- Hover on a parent Button -->
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
        <Setter Property="Stroke" Value="{DynamicResource IconHoverBrush}"/>
      </DataTrigger>
      <!-- Pressed state on a parent Button -->
      <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
        <Setter Property="Stroke" Value="{DynamicResource IconActiveBrush}"/>
      </DataTrigger>
      <!-- Selected tab state -->
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
        <Setter Property="Stroke" Value="{DynamicResource IconActiveBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>