<Window x:Class="WeatherWall.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WeatherWall" Height="300" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">
    
    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.4" />
        </Storyboard>
    </Window.Resources>

    <Border Background="#121212" CornerRadius="12" BorderBrush="#2A2A2A" BorderThickness="1">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/WW/HD.png" Width="120" Height="120" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                    </Image.Effect>
                </Image>
                
                <TextBlock Text="WeatherWall" 
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center" 
                           Margin="0,15,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Arial"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                
                <TextBlock Text="Adaptive Desktop Environments" 
                           Foreground="#888888" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Optional: Progress Bar (Very subtle) -->
            <ProgressBar IsIndeterminate="True" 
                         Height="2" 
                         VerticalAlignment="Bottom" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Foreground="#3A3A3A" 
                         Margin="40,0,40,30" 
                         Opacity="0.5"/>
        </Grid>
    </Border>
</Window>
